// ==========================================
// CORE TENANT (SCHOOL)
// ==========================================

model School {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  code      String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  users                        User[]
  students                     Student[]
  parents                      Parent[]
  classes                      Class[]
  academicSessions             AcademicSession[]
  teachers                     Teacher[]
  subjects                     Subject[]
  curriculumMaps               CurriculumMap[]
  attendanceRecords            AttendanceRecord[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]
  teacherAttendances           TeacherAttendance[]
  exams                        Exam[]
  studentMarks                 StudentMark[]
  gradeScales                  GradeScale[]
  results                      Result[]
  periods                      Period[]
  classrooms                   Classroom[]
  timetables                   Timetable[]

  feeCategories    FeeCategory[]
  feeStructures    FeeStructure[]
  payments         Payment[]
  notices          Notice[]
  noticeCategories NoticeCategory[]
  leaveRequests    LeaveRequest[]

  @@index([code])
  @@map("schools")
}

// ==========================================
// IDENTITY & AUTHENTICATION MODULE (IdP)
// ==========================================

model User {
  id                        String        @id @default(uuid()) @db.Uuid
  schoolId                  String?       @map("school_id") @db.Uuid
  email                     String        @unique @db.VarChar(255)
  passwordHash              String        @map("password_hash") @db.VarChar(255)
  role                      Role          @default(PARENT)
  accountStatus             AccountStatus @default(ACTIVE) @map("account_status")
  isActive                  Boolean       @default(true) @map("is_active")
  failedLoginAttempts       Int           @default(0) @map("failed_login_attempts")
  lockedUntil               DateTime?     @map("locked_until")
  temporaryPasswordRequired Boolean       @default(true) @map("temporary_password_required")

  // Basic Profile (Kept minimal in Auth)
  fullName String  @map("full_name") @db.VarChar(255)
  phone    String? @db.VarChar(20)

  // Audit Fields
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relationships
  school              School?                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  parentProfile       Parent?
  classAssignments    ClassTeacherAssignment[]
  teacherProfile      Teacher?

  // Explicit relations for Examination Module
  marksEntered  StudentMark[] @relation("MarksEnteredBy")
  marksVerified StudentMark[] @relation("MarksVerifiedBy")
  timetables    Timetable[]

  // Fee Management Relations
  feeStructures FeeStructure[] @relation("FeeStructureCreator")
  feeLedgers    FeeLedger[]    @relation("FeeLedgerCreator")
  payments      Payment[]      @relation("PaymentCollector")
  receipts      Receipt[]      @relation("ReceiptGenerator")
  discounts     Discount[]     @relation("DiscountApprover")
  fines         Fine[]         @relation("FineCreator")

  //notice board 
  noticesCreated        Notice[]               @relation("NoticeCreator")
  noticesUpdated        Notice[]               @relation("NoticeUpdater")
  noticeReadReceipts    NoticeReadReceipt[]
  noticeAcknowledgments NoticeAcknowledgment[]
  noticeComments        NoticeComment[]
  noticeTargets         NoticeTarget[]

  //leave Management
  leaveApplications LeaveRequest[] @relation("LeaveApplicant")
  leavesSubmitted   LeaveRequest[] @relation("LeaveSubmitter")
  leaveApprovals    LeaveRequest[] @relation("LeaveApprover")

  @@index([schoolId])
  @@index([email])
  @@index([isActive])
  @@map("users")
}

// [Audit Log, RefreshToken, PasswordResetToken remain identical to your current schema...]
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(255)
  entityType String   @map("entity_type") @db.VarChar(255)
  entityId   String?  @map("entity_id") @db.Uuid
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  timestamp  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  userAgent String?  @map("user_agent") @db.Text
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

// ==========================================
// USER DEMOGRAPHICS & ERP MODULE
// ==========================================

model Address {
  id           String  @id @default(uuid()) @db.Uuid
  addressLine1 String  @map("address_line_1") @db.VarChar(255)
  addressLine2 String? @map("address_line_2") @db.VarChar(255)
  city         String  @db.VarChar(100)
  state        String  @db.VarChar(100)
  zipCode      String  @map("zip_code") @db.VarChar(20)
  country      String  @default("India") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  parents  Parent[]
  students Student[]
  teachers Teacher[]

  @@map("addresses")
}

model Parent {
  id        String  @id @default(uuid()) @db.Uuid
  schoolId  String  @map("school_id") @db.Uuid
  userId    String  @unique @map("user_id") @db.Uuid // Links to Auth User
  addressId String? @map("address_id") @db.Uuid

  firstName      String  @map("first_name") @db.VarChar(100)
  lastName       String  @map("last_name") @db.VarChar(100)
  primaryPhone   String  @map("primary_phone") @db.VarChar(20)
  alternatePhone String? @map("alternate_phone") @db.VarChar(20)
  occupation     String? @db.VarChar(100)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relationships
  school        School          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  address       Address?        @relation(fields: [addressId], references: [id], onDelete: SetNull)
  children      Student[] // One parent can have multiple students
  students      ParentStudent[] // Replaces the One-to-Many children array
  noticeTargets NoticeTarget[]

  @@index([schoolId])
  @@map("parents")
}

model AcademicSession {
  id        String       @id @default(uuid()) @db.Uuid
  schoolId  String       @map("school_id") @db.Uuid
  name      String       @db.VarChar(50) // E.g., "2025-2026"
  startDate DateTime     @map("start_date") @db.Date
  endDate   DateTime     @map("end_date") @db.Date
  status    EntityStatus @default(ACTIVE)

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classes        Class[]
  curriculumMaps CurriculumMap[]

  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  attendanceRecords AttendanceRecord[]
  exams             Exam[]
  timetables        Timetable[]
  feeStructures     FeeStructure[]
  notices           Notice[]

  @@index([schoolId])
  @@map("academic_sessions")
}

model Class {
  id                String @id @default(uuid()) @db.Uuid
  schoolId          String @map("school_id") @db.Uuid
  academicSessionId String @map("academic_session_id") @db.Uuid

  name         String       @db.VarChar(50) // E.g., "Class 10"
  code         String       @db.VarChar(20) // E.g., "C10"
  displayOrder Int          @map("display_order")
  description  String?      @db.Text
  status       EntityStatus @default(ACTIVE)

  school          School                   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicSession AcademicSession          @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  sections        Section[]
  assignments     ClassTeacherAssignment[]

  createdBy      String?         @map("created_by") @db.Uuid
  updatedBy      String?         @map("updated_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  students       Student[]
  curriculumMaps CurriculumMap[]
  examSubjects   ExamSubject[]
  timetables     Timetable[]
  feeStructures  FeeStructure[]
  noticeTargets  NoticeTarget[]

  // Enforces PRD Rule: Class Name must be unique within a school and session.
  @@unique([schoolId, academicSessionId, name])
  @@index([schoolId])
  @@index([academicSessionId])
  @@map("classes")
}

model Section {
  id      String @id @default(uuid()) @db.Uuid
  classId String @map("class_id") @db.Uuid

  name       String       @db.VarChar(20) // E.g., "A", "B"
  roomNumber String?      @map("room_number") @db.VarChar(50)
  capacity   Int          @default(40)
  status     EntityStatus @default(ACTIVE)

  class       Class                    @relation(fields: [classId], references: [id], onDelete: Restrict)
  assignments ClassTeacherAssignment[]

  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  students      Student[]
  examSubjects  ExamSubject[]
  timetables    Timetable[]
  noticeTargets NoticeTarget[]

  // Enforces PRD Rule: Section Name must be unique within a class.
  @@unique([classId, name])
  @@index([classId])
  @@map("sections")
}

model ClassTeacherAssignment {
  id        String  @id @default(uuid()) @db.Uuid
  classId   String  @map("class_id") @db.Uuid
  sectionId String? @map("section_id") @db.Uuid
  teacherId String  @map("teacher_id") @db.Uuid

  assignmentType AssignmentType @default(PRIMARY) @map("assignment_type")
  startDate      DateTime       @map("start_date") @db.Date
  endDate        DateTime?      @map("end_date") @db.Date

  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher User     @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([classId])
  @@index([sectionId])
  @@index([teacherId])
  @@map("class_teacher_assignments")
}

model Student {
  id        String  @id @default(uuid()) @db.Uuid
  schoolId  String  @map("school_id") @db.Uuid
  // REMOVED: parentId (Migrated to ParentStudent mapping)
  classId   String  @map("class_id") @db.Uuid
  sectionId String? @map("section_id") @db.Uuid // Added to track current section
  addressId String? @map("address_id") @db.Uuid

  admissionNumber String      @unique @map("admission_number") @db.VarChar(50) // Renamed from enrollmentNumber
  firstName       String      @map("first_name") @db.VarChar(100)
  lastName        String      @map("last_name") @db.VarChar(100)
  dateOfBirth     DateTime    @map("date_of_birth") @db.Date
  gender          Gender
  bloodGroup      BloodGroup? @map("blood_group")
  religion        String?     @db.VarChar(50) // Added from PRD
  nationality     String?     @default("Indian") @db.VarChar(50) // Added from PRD
  medicalBrief    String?     @map("medical_brief") @db.Text

  aadharNumber  String?  @unique @map("aadhar_number") @db.VarChar(12)
  admissionDate DateTime @default(now()) @map("admission_date") @db.Date

  status StudentStatus @default(ACTIVE) // Replaced isActive boolean

  // Audit & Soft Delete
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relationships
  school            School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  class             Class              @relation(fields: [classId], references: [id], onDelete: Restrict)
  section           Section?           @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  address           Address?           @relation(fields: [addressId], references: [id], onDelete: SetNull)
  parents           ParentStudent[]
  documents         StudentDocument[]
  academicHistory   AcademicHistory[]
  parent            Parent?            @relation(fields: [parentId], references: [id])
  parentId          String?            @db.Uuid
  attendanceRecords AttendanceRecord[]
  studentMarks      StudentMark[]
  results           Result[]

  feeAssignments StudentFeeAssignment[]
  feeLedgers     FeeLedger[]
  payments       Payment[]
  discounts      Discount[]
  fines          Fine[]

  noticeTargets NoticeTarget[]
  leaveRequests LeaveRequest[]

  @@index([schoolId])
  @@index([classId])
  @@index([admissionNumber])
  @@index([aadharNumber])
  @@map("students")
}

model ParentStudent {
  id                      String           @id @default(uuid()) @db.Uuid
  parentId                String           @map("parent_id") @db.Uuid
  studentId               String           @map("student_id") @db.Uuid
  relationshipType        RelationshipType @map("relationship_type")
  isPrimaryGuardian       Boolean          @default(false) @map("is_primary_guardian")
  isEmergencyContact      Boolean          @default(false) @map("is_emergency_contact")
  canReceiveNotifications Boolean          @default(true) @map("can_receive_notifications")

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@map("parent_students")
}

model StudentDocument {
  id                 String                     @id @default(uuid()) @db.Uuid
  studentId          String                     @map("student_id") @db.Uuid
  documentName       String                     @map("document_name") @db.VarChar(255)
  documentType       String                     @map("document_type") @db.VarChar(100)
  fileUrl            String                     @map("file_url") @db.VarChar(500)
  verificationStatus DocumentVerificationStatus @default(PENDING) @map("verification_status")
  expiryDate         DateTime?                  @map("expiry_date") @db.Date

  uploadedBy String   @map("uploaded_by") @db.Uuid
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_documents")
}

model AcademicHistory {
  id                String  @id @default(uuid()) @db.Uuid
  studentId         String  @map("student_id") @db.Uuid
  academicSessionId String? @map("academic_session_id") @db.Uuid
  previousClassId   String? @map("previous_class_id") @db.Uuid
  newClassId        String? @map("new_class_id") @db.Uuid
  previousSectionId String? @map("previous_section_id") @db.Uuid
  newSectionId      String? @map("new_section_id") @db.Uuid

  eventType AcademicEventType @map("event_type")
  eventDate DateTime          @default(now()) @map("event_date")
  notes     String?           @db.Text

  createdBy String @map("created_by") @db.Uuid

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([eventType])
  @@map("academic_history")
}

model Teacher {
  id        String  @id @default(uuid()) @db.Uuid
  schoolId  String  @map("school_id") @db.Uuid
  userId    String  @unique @map("user_id") @db.Uuid // Links to Auth User
  addressId String? @map("address_id") @db.Uuid

  employeeId String @map("employee_id") @db.VarChar(50)

  // Personal Information
  firstName     String         @map("first_name") @db.VarChar(100)
  lastName      String         @map("last_name") @db.VarChar(100)
  dateOfBirth   DateTime?      @map("date_of_birth") @db.Date
  gender        Gender
  bloodGroup    BloodGroup?    @map("blood_group")
  maritalStatus MaritalStatus? @map("marital_status")
  photoUrl      String?        @map("photo_url") @db.VarChar(500)

  // Contact Information
  email          String? @db.VarChar(255)
  phone          String  @db.VarChar(20)
  alternatePhone String? @map("alternate_phone") @db.VarChar(20)

  // Professional Information
  qualification   String?        @db.VarChar(255)
  experienceYears Int?           @map("experience_years")
  department      String?        @db.VarChar(100)
  designation     String?        @db.VarChar(100)
  joiningDate     DateTime?      @map("joining_date") @db.Date
  employmentType  EmploymentType @default(FULL_TIME) @map("employment_type")

  status TeacherStatus @default(ACTIVE)

  // Audit Fields
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // For Soft Delete

  // Relationships
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  address            Address?            @relation(fields: [addressId], references: [id], onDelete: SetNull)
  teacherAttendances TeacherAttendance[]
  invigilations      ExamSchedule[]      @relation("TeacherInvigilations") // Added this line
  timetableSlots     TimetableSlot[]
  noticeTargets      NoticeTarget[]

  // Indexes & Constraints
