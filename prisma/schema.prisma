// ==========================================
// ATTENDANCE MODULE MODELS
// ==========================================

model AttendanceRecord {
  id                String                  @id @default(uuid()) @db.Uuid
  schoolId          String                  @map("school_id") @db.Uuid
  studentId         String                  @map("student_id") @db.Uuid
  academicSessionId String                  @map("academic_session_id") @db.Uuid
  attendanceDate    DateTime                @map("attendance_date") @db.Date
  status            StudentAttendanceStatus
  remarks           String?                 @db.Text
  markedBy          String                  @map("marked_by") @db.Uuid
  updatedBy         String?                 @map("updated_by") @db.Uuid
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  deletedAt         DateTime?               @map("deleted_at")

  // Relations
  school          School                        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student         Student                       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicSession AcademicSession               @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  corrections     AttendanceCorrectionRequest[]

  @@unique([studentId, attendanceDate]) // Prevent duplicate entries [cite: 132, 133, 213]
  @@index([schoolId])
  @@index([attendanceDate])
  @@index([status])
  @@index([academicSessionId])
  @@index([studentId])
  @@map("attendance_records")
}

model AttendanceCorrectionRequest {
  id                 String                  @id @default(uuid()) @db.Uuid
  schoolId           String                  @map("school_id") @db.Uuid
  attendanceRecordId String                  @map("attendance_record_id") @db.Uuid
  oldStatus          StudentAttendanceStatus @map("old_status")
  newStatus          StudentAttendanceStatus @map("new_status")
  reason             String                  @db.Text
  requestedBy        String                  @map("requested_by") @db.Uuid
  approvedBy         String?                 @map("approved_by") @db.Uuid
  approvedAt         DateTime?               @map("approved_at")
  status             CorrectionStatus        @default(PENDING)
  createdAt          DateTime                @default(now()) @map("created_at")

  // Relations
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([attendanceRecordId])
  @@index([status])
  @@map("attendance_correction_requests")
}

model TeacherAttendance {
  id             String                  @id @default(uuid()) @db.Uuid
  schoolId       String                  @map("school_id") @db.Uuid
  teacherId      String                  @map("teacher_id") @db.Uuid
  attendanceDate DateTime                @map("attendance_date") @db.Date
  status         TeacherAttendanceStatus
  checkInTime    DateTime?               @map("check_in_time")
  checkOutTime   DateTime?               @map("check_out_time")
  remarks        String?                 @db.Text
  recordedBy     String                  @map("recorded_by") @db.Uuid
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  // Relations
  school  School  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, attendanceDate]) // Prevent duplicate check-ins [cite: 153, 222]
  @@index([schoolId])
  @@index([attendanceDate])
  @@map("teacher_attendance")
}

// Exam Module
model Exam {
  id                String   @id @default(uuid()) @db.Uuid
  schoolId          String   @map("school_id") @db.Uuid
  academicSessionId String   @map("academic_session_id") @db.Uuid
  name              String   @db.VarChar(255)
  examType          ExamType @map("exam_type")
  description       String?  @db.Text
  startDate         DateTime @map("start_date") @db.Date
  endDate           DateTime @map("end_date") @db.Date
  isPublished       Boolean  @default(false) @map("is_published")
  isLocked          Boolean  @default(false) @map("is_locked")

  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete behavior [cite: 441]

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  subjects        ExamSubject[]
