  @@unique([studentId, examSubjectId])
  @@map("student_marks")
}

model GradeScale {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  name          String   @db.VarChar(100)
  minPercentage Float    @map("min_percentage")
  maxPercentage Float    @map("max_percentage")
  grade         String   @db.VarChar(5)
  gradePoint    Float    @map("grade_point")
  remarks       String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@map("grade_scales")
}

model Result {
  id                   String       @id @default(uuid()) @db.Uuid
  schoolId             String       @map("school_id") @db.Uuid
  examId               String       @map("exam_id") @db.Uuid
  studentId            String       @map("student_id") @db.Uuid
  totalMarks           Float        @map("total_marks")
  obtainedMarks        Float        @map("obtained_marks")
  percentage           Float
  grade                String       @db.VarChar(5)
  rank                 Int?
  gpa                  Float?
  attendancePercentage Float?       @map("attendance_percentage")
  resultStatus         ResultStatus @map("result_status")
  publishedAt          DateTime?    @map("published_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@map("results")
}

// ==========================================
// TIMETABLE MODULE MODELS
// ==========================================

model Period {
  id           String     @id @default(uuid()) @db.Uuid
  schoolId     String     @map("school_id") @db.Uuid
  name         String     @db.VarChar(50) // e.g., "Period 1", "Lunch Break"
  type         PeriodType @default(LECTURE)
  startTime    DateTime   @map("start_time") @db.Time
  endTime      DateTime   @map("end_time") @db.Time
  displayOrder Int        @map("display_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school School          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  slots  TimetableSlot[]

  @@index([schoolId])
  @@map("periods")
}

model Classroom {
  id       String   @id @default(uuid()) @db.Uuid
  schoolId String   @map("school_id") @db.Uuid
  name     String   @db.VarChar(50)
  building String?  @db.VarChar(100)
  floor    String?  @db.VarChar(20)
  capacity Int
  roomType RoomType @default(LECTURE_HALL) @map("room_type")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete required by PRD

  school School          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  slots  TimetableSlot[]

  @@index([schoolId])
  @@map("classrooms")
}

model Timetable {
  id                String          @id @default(uuid()) @db.Uuid
  schoolId          String          @map("school_id") @db.Uuid
  academicSessionId String          @map("academic_session_id") @db.Uuid
  classId           String          @map("class_id") @db.Uuid
  sectionId         String          @map("section_id") @db.Uuid
  version           Int             @default(1)
  status            TimetableStatus @default(DRAFT)

  publishedBy String?   @map("published_by") @db.Uuid
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  class           Class           @relation(fields: [classId], references: [id], onDelete: Restrict)
  section         Section         @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  publisher       User?           @relation(fields: [publishedBy], references: [id], onDelete: SetNull)
  slots           TimetableSlot[]

  // Constraint: Unique (schoolId, academicSessionId, classId, sectionId, version)
  @@unique([schoolId, academicSessionId, classId, sectionId, version])
  @@index([schoolId])
  @@index([status])
  @@map("timetables")
}

model TimetableSlot {
  id          String    @id @default(uuid()) @db.Uuid
  timetableId String    @map("timetable_id") @db.Uuid
  dayOfWeek   DayOfWeek @map("day_of_week")
  periodId    String    @map("period_id") @db.Uuid
  subjectId   String?   @map("subject_id") @db.Uuid
  teacherId   String?   @map("teacher_id") @db.Uuid
  classroomId String?   @map("classroom_id") @db.Uuid
  notes       String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  timetable Timetable  @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  period    Period     @relation(fields: [periodId], references: [id], onDelete: Restrict)
  subject   Subject?   @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher   Teacher?   @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  classroom Classroom? @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  // Validation: Unique(dayOfWeek, periodId, timetableId)
  @@unique([timetableId, dayOfWeek, periodId])
  @@index([timetableId])
  @@index([teacherId, dayOfWeek]) // Crucial index for teacher conflict detection
  @@index([classroomId, dayOfWeek]) // Crucial index for classroom conflict detection
  @@map("timetable_slots")
}

// ==========================================
// FEE MANAGEMENT & RECEIPT MODULE MODELS
// ==========================================

model FeeCategory {
  id            String        @id @default(uuid()) @db.Uuid
  schoolId      String        @map("school_id") @db.Uuid
  name          String        @db.VarChar(100)
  code          String        @db.VarChar(50)
  recurringType RecurringType @map("recurring_type")
  description   String?       @db.Text
  isActive      Boolean       @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  feeStructures FeeStructure[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("fee_categories")
}

model FeeStructure {
  id                String @id @default(uuid()) @db.Uuid
  schoolId          String @map("school_id") @db.Uuid
  academicSessionId String @map("academic_session_id") @db.Uuid
  classId           String @map("class_id") @db.Uuid
  feeCategoryId     String @map("fee_category_id") @db.Uuid

  amount        Float
  dueDate       DateTime      @map("due_date") @db.Date
  recurrence    RecurringType
  isOptional    Boolean       @default(false) @map("is_optional")
  effectiveFrom DateTime      @map("effective_from") @db.Date
  effectiveTo   DateTime?     @map("effective_to") @db.Date

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  school          School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicSession AcademicSession        @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  class           Class                  @relation(fields: [classId], references: [id], onDelete: Restrict)
  feeCategory     FeeCategory            @relation(fields: [feeCategoryId], references: [id], onDelete: Restrict)
  creator         User?                  @relation("FeeStructureCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  assignments     StudentFeeAssignment[]

  @@index([schoolId])
  @@index([academicSessionId])
  @@index([classId])
  @@map("fee_structures")
}

model StudentFeeAssignment {
  id             String              @id @default(uuid()) @db.Uuid
  studentId      String              @map("student_id") @db.Uuid
  feeStructureId String              @map("fee_structure_id") @db.Uuid
  assignedAmount Float               @map("assigned_amount")
  assignedDate   DateTime            @default(now()) @map("assigned_date") @db.Date
  status         FeeAssignmentStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)

  @@unique([studentId, feeStructureId])
  @@index([studentId])
  @@map("student_fee_assignments")
}

model FeeLedger {
  id              String          @id @default(uuid()) @db.Uuid
  studentId       String          @map("student_id") @db.Uuid
  transactionType TransactionType @map("transaction_type")
  amount          Float
  balanceAfter    Float           @map("balance_after")
  referenceId     String?         @map("reference_id") @db.Uuid // ID of Payment, Assignment, Fine, or Discount
  remarks         String?         @db.Text

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  creator User?   @relation("FeeLedgerCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([transactionType])
  @@map("fee_ledgers")
}

model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  paymentNumber        String        @unique @map("payment_number") @db.VarChar(50)
  schoolId             String        @map("school_id") @db.Uuid
  studentId            String        @map("student_id") @db.Uuid
  amountPaid           Float         @map("amount_paid")
  paymentMode          PaymentMode   @map("payment_mode")
  transactionReference String?       @map("transaction_reference") @db.VarChar(100)
  remarks              String?       @db.Text
  paymentStatus        PaymentStatus @default(SUCCESS) @map("payment_status")

  collectedBy String?  @map("collected_by") @db.Uuid
  collectedAt DateTime @default(now()) @map("collected_at")

  // Relations
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  collector User?    @relation("PaymentCollector", fields: [collectedBy], references: [id], onDelete: SetNull)
  receipt   Receipt?

  @@index([schoolId])
  @@index([studentId])
  @@map("payments")
}

model Receipt {
  id            String   @id @default(uuid()) @db.Uuid
  receiptNumber String   @unique @map("receipt_number") @db.VarChar(50)
  paymentId     String   @unique @map("payment_id") @db.Uuid
  generatedAt   DateTime @default(now()) @map("generated_at")
  generatedBy   String?  @map("generated_by") @db.Uuid
  pdfUrl        String?  @map("pdf_url") @db.VarChar(500)

  // Relations
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  generator User?   @relation("ReceiptGenerator", fields: [generatedBy], references: [id], onDelete: SetNull)

  @@index([receiptNumber])
  @@map("receipts")
}

model Discount {
  id        String       @id @default(uuid()) @db.Uuid
  studentId String       @map("student_id") @db.Uuid
  type      DiscountType
  value     Float
  reason    String       @db.VarChar(255)

  approvedBy String?  @map("approved_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  approver User?   @relation("DiscountApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@map("discounts")
}

model Fine {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @map("student_id") @db.Uuid
  amount    Float
  reason    String @db.VarChar(255)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  creator User?   @relation("FineCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@map("fines")
}

// Homework and Assignment
model Assignment {
  id                             String           @id @default(uuid()) @db.Uuid
  schoolId                       String           @db.Uuid
  academicSessionId              String           @db.Uuid
  classId                        String           @db.Uuid
  sectionId                      String           @db.Uuid
  subjectId                      String           @db.Uuid
  teacherId                      String           @db.Uuid
  title                          String           @db.VarChar(200)
  description                    String           @db.Text
  clarificationNote              String?          @db.Text
  status                         AssignmentStatus @default(DRAFT)
  submissionType                 SubmissionType   @default(TEXT_AND_FILE)
  maxScore                       Decimal          @default(100.00) @db.Decimal(6, 2)
  dueDate                        DateTime         @db.Timestamptz
  publishAt                      DateTime?        @db.Timestamptz
  publishedAt                    DateTime?        @db.Timestamptz
  gracePeriodHours               Int              @default(0) @db.SmallInt
  allowLateSubmission            Boolean          @default(true)
  lateSubmissionPenaltyPercent   Decimal          @default(0.00) @db.Decimal(5, 2)
  allowResubmission              Boolean          @default(true)
  maxAttempts                    Int              @default(1) @db.SmallInt
  allowStudentComments           Boolean          @default(true)
  instructionsAttachmentRequired Boolean          @default(false)
  createdBy                      String           @db.Uuid
  updatedBy                      String?          @db.Uuid
  createdAt                      DateTime         @default(now()) @db.Timestamptz
  updatedAt                      DateTime         @updatedAt @db.Timestamptz
  deletedAt                      DateTime?        @db.Timestamptz
  deletedBy                      String?          @db.Uuid

  // Note: Ensure relations match your existing models (School, AcademicSession, Class, Section, Subject, Teacher)
  submissions AssignmentSubmission[]

  @@index([schoolId, status, deletedAt], name: "idx_assignment_school_status")
  @@index([schoolId, classId, sectionId, subjectId, academicSessionId], name: "idx_assignment_class_section_subject")
  @@index([schoolId, teacherId, status], name: "idx_assignment_teacher")
  @@index([schoolId, dueDate], name: "idx_assignment_due_date")
  @@index([schoolId, publishAt], name: "idx_assignment_publish_at") // Partial index conceptualized
  @@map("assignments")
}

model AssignmentSubmission {
  id                 String                     @id @default(uuid()) @db.Uuid
  assignmentId       String                     @db.Uuid
  schoolId           String                     @db.Uuid
  studentId          String                     @db.Uuid
  submissionGroupId  String                     @db.Uuid
  attemptNumber      Int                        @default(1) @db.SmallInt
  status             AssignmentSubmissionStatus @default(DRAFT)
  textResponse       String?                    @db.Text
  isLate             Boolean                    @default(false)
  submittedAt        DateTime?                  @db.Timestamptz
  viewedByTeacherAt  DateTime?                  @db.Timestamptz
  score              Decimal?                   @db.Decimal(6, 2)
  latePenaltyApplied Decimal?                   @db.Decimal(5, 2)
  finalScore         Decimal?                   @db.Decimal(6, 2)
  gradedBy           String?                    @db.Uuid
  gradedAt           DateTime?                  @db.Timestamptz
  returnedAt         DateTime?                  @db.Timestamptz
  lockedAt           DateTime?                  @db.Timestamptz
  idempotencyKey     String?                    @db.VarChar(128)
  createdAt          DateTime                   @default(now()) @db.Timestamptz
  updatedAt          DateTime                   @updatedAt @db.Timestamptz
  deletedAt          DateTime?                  @db.Timestamptz
  deletedBy          String?                    @db.Uuid

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId, attemptNumber], name: "idx_submission_assignment_student")
  @@unique([schoolId, idempotencyKey], name: "idx_submission_idempotency")
  @@index([submissionGroupId, attemptNumber], name: "idx_submission_group")
  @@index([schoolId, assignmentId, status], name: "idx_submission_status")
  @@index([schoolId, studentId, status], name: "idx_submission_student_school")
  @@map("assignment_submissions")
}

model AssignmentAudit {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @db.Uuid
  entityType    String   @db.VarChar(50)
  entityId      String   @db.Uuid
  action        String   @db.VarChar(60)
  actorId       String   @db.Uuid
  actorRole     String   @db.VarChar(20)
  oldValues     Json?    @db.JsonB
  newValues     Json?    @db.JsonB
  correlationId String   @db.Uuid
  ipAddress     String?  @db.VarChar(45)
  userAgent     String?  @db.VarChar(500)
  createdAt     DateTime @default(now()) @db.Timestamptz

  @@index([schoolId, entityType, entityId, createdAt], name: "idx_audit_entity")
  @@index([schoolId, actorId, createdAt], name: "idx_audit_actor")
  @@index([correlationId], name: "idx_audit_correlation")
  @@map("assignment_audits")
}

// ==========================================
// NOTICE BOARD & CIRCULAR MODULE
// ==========================================

model Notice {
  id                String  @id @default(uuid()) @db.Uuid
  schoolId          String  @map("school_id") @db.Uuid
  academicSessionId String? @map("academic_session_id") @db.Uuid
  categoryId        String? @map("category_id") @db.Uuid

  title   String  @db.VarChar(255)
  content String  @db.Text
  summary String? @db.VarChar(500)

  type     NoticeType     @default(NOTICE)
  priority NoticePriority @default(NORMAL)
  status   NoticeStatus   @default(DRAFT)

  isPinned Boolean @default(false) @map("is_pinned")
  pinOrder Int     @default(0) @map("pin_order")

  publishAt   DateTime? @map("publish_at") @db.Timestamptz
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz
  publishedAt DateTime? @map("published_at") @db.Timestamptz
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz

  requiresAcknowledgment Boolean   @default(false) @map("requires_acknowledgment")
  acknowledgmentDeadline DateTime? @map("acknowledgment_deadline") @db.Timestamptz
  allowComments          Boolean   @default(true) @map("allow_comments")

  viewCount           Int @default(0) @map("view_count")
  uniqueReaderCount   Int @default(0) @map("unique_reader_count")
  acknowledgmentCount Int @default(0) @map("acknowledgment_count")

  createdBy String    @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy String?   @map("deleted_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicSession AcademicSession? @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  category        NoticeCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  creator         User             @relation("NoticeCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater         User?            @relation("NoticeUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  targets         NoticeTarget[]
  attachments     NoticeAttachment[]
  readReceipts    NoticeReadReceipt[]
  acknowledgments NoticeAcknowledgment[]
  comments        NoticeComment[]
  auditLogs       NoticeAudit[]

  // Indexes
  @@index([schoolId, status, deletedAt], name: "idx_notice_school_status")
  @@index([schoolId, isPinned, status, pinOrder], name: "idx_notice_pinned")
  @@index([schoolId, type, status, priority], name: "idx_notice_type_status")
  @@index([schoolId, publishAt], name: "idx_notice_publish")
  @@index([schoolId, expiresAt], name: "idx_notice_expiry")
  @@index([schoolId, createdAt], name: "idx_notice_created")
  @@index([schoolId, academicSessionId], name: "idx_notice_session")
  @@index([schoolId, categoryId], name: "idx_notice_category")
  @@map("notices")
}

model NoticeCategory {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @map("school_id") @db.Uuid

  name         String  @db.VarChar(100)
  code         String  @db.VarChar(50)
  description  String? @db.Text
  color        String? @db.VarChar(7)
  icon         String? @db.VarChar(50)
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  notices Notice[]

  @@unique([schoolId, code])
  @@index([schoolId, isActive])
  @@map("notice_categories")
}

model NoticeTarget {
  id              String     @id @default(uuid()) @db.Uuid
  noticeId        String     @map("notice_id") @db.Uuid
  targetType      TargetType
  targetRole      Role?      @map("target_role") // Ensure the 'Role' enum exists in your base schema
  targetClassId   String?    @map("target_class_id") @db.Uuid
  targetSectionId String?    @map("target_section_id") @db.Uuid
  targetStudentId String?    @map("target_student_id") @db.Uuid
  targetParentId  String?    @map("target_parent_id") @db.Uuid
  targetTeacherId String?    @map("target_teacher_id") @db.Uuid
  targetUserId    String?    @map("target_user_id") @db.Uuid

  notice        Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  targetClass   Class?   @relation(fields: [targetClassId], references: [id], onDelete: SetNull)
  targetSection Section? @relation(fields: [targetSectionId], references: [id], onDelete: SetNull)
  targetStudent Student? @relation(fields: [targetStudentId], references: [id], onDelete: SetNull)
  targetParent  Parent?  @relation(fields: [targetParentId], references: [id], onDelete: SetNull)
  targetTeacher Teacher? @relation(fields: [targetTeacherId], references: [id], onDelete: SetNull)
  targetUser    User?    @relation(fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([noticeId])
  @@index([targetType])
  @@index([targetClassId])
  @@index([targetSectionId])
  @@index([targetStudentId])
  @@index([targetParentId])
  @@index([targetTeacherId])
  @@index([targetUserId])
  @@map("notice_targets")
}

model NoticeAttachment {
  id       String @id @default(uuid()) @db.Uuid
  noticeId String @map("notice_id") @db.Uuid
  schoolId String @map("school_id") @db.Uuid

  fileName     String  @map("file_name") @db.VarChar(255)
  originalName String  @map("original_name") @db.VarChar(255)
  mimeType     String  @map("mime_type") @db.VarChar(100)
  fileSize     Int     @map("file_size")
  fileUrl      String  @map("file_url") @db.VarChar(500)
  fileHash     String? @map("file_hash") @db.VarChar(64)

  uploadedBy String   @map("uploaded_by") @db.Uuid
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@index([noticeId])
  @@index([schoolId])
  @@map("notice_attachments")
}

model NoticeReadReceipt {
  id       String @id @default(uuid()) @db.Uuid
  noticeId String @map("notice_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  schoolId String @map("school_id") @db.Uuid

  readAt    DateTime @default(now()) @map("read_at") @db.Timestamptz
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.Text

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
  @@index([noticeId])
  @@index([userId])
  @@index([schoolId])
  @@map("notice_read_receipts")
}

model NoticeAcknowledgment {
  id       String @id @default(uuid()) @db.Uuid
  noticeId String @map("notice_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  schoolId String @map("school_id") @db.Uuid

  status         AcknowledgmentStatus @default(PENDING)
  acknowledgedAt DateTime?            @map("acknowledged_at") @db.Timestamptz
  declinedAt     DateTime?            @map("declined_at") @db.Timestamptz
  remarks        String?              @db.Text
  signatureUrl   String?              @map("signature_url") @db.VarChar(500)
  ipAddress      String?              @map("ip_address") @db.VarChar(45)
  userAgent      String?              @map("user_agent") @db.Text

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
  @@index([noticeId])
  @@index([userId])
  @@index([schoolId, status])
  @@map("notice_acknowledgments")
}

model NoticeComment {
  id       String @id @default(uuid()) @db.Uuid
  noticeId String @map("notice_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  schoolId String @map("school_id") @db.Uuid

  content         String    @db.Text
  isEdited        Boolean   @default(false) @map("is_edited")
  editedAt        DateTime? @map("edited_at") @db.Timestamptz
  parentCommentId String?   @map("parent_comment_id") @db.Uuid

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy String?   @map("deleted_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  notice        Notice          @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentComment NoticeComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies       NoticeComment[] @relation("CommentReplies")

  @@index([noticeId, isDeleted, createdAt])
  @@index([userId])
  @@map("notice_comments")
}

model NoticeAudit {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  noticeId      String   @map("notice_id") @db.Uuid
  action        String   @db.VarChar(60)
  actorId       String   @map("actor_id") @db.Uuid
  actorRole     String   @map("actor_role") @db.VarChar(20)
  oldValues     Json?    @db.JsonB
  newValues     Json?    @db.JsonB
  correlationId String   @db.Uuid
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@index([schoolId, noticeId, createdAt])
  @@index([schoolId, actorId, createdAt])
  @@index([correlationId])
  @@map("notice_audits")
}

