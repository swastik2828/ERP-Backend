# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_erp?schema=public"

# JWT Auth Secrets
JWT_ACCESS_SECRET=your_super_secret_access_key_replace_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_replace_in_production

# JWT Expirations
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Reset
PASSWORD_RESET_TOKEN_EXPIRES_IN=1h

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100